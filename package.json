{
  "name": "dsh-ai-credits",
  "version": "2.7.3",
  "type": "module",
  "description": "AI 免费额度与积分聚合 + 各家 API 价格表 + 订阅对比 + 模型线路与用量花费：官方价实时核对、按峰谷分时价与缓存命中计价、fork 会话自动去重、一键导入官方用量 CSV 对账、按会话分段查看 token 消耗时间轴、统计云端出图/生视频的按张与按 token 花费。数据只存在本地，不上传。",
  "engines": {
    "dsh": ">=0.2.2-rc.1"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./prices": "./prices.js",
    "./plans": "./plans.js",
    "./codingplan": "./codingplan.js",
    "./dsh-api": "./dsh-api.js",
    "./usage": "./usage.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./pricing-sync": "./pricing-sync.js",
    "./official-usage": "./official-usage.js",
    "./media-prices": "./media-prices.js",
    "./media-ledger": "./media-ledger.js",
    "./opencode-go": "./opencode-go.js"
  },
  "files": [
    "index.js",
    "client.js",
    "prices.js",
    "plans.js",
    "codingplan.js",
    "dsh-api.js",
    "usage.js",
    "pricing-sync.js",
    "official-usage.js",
    "media-prices.js",
    "media-ledger.js",
    "opencode-go.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  }
}
